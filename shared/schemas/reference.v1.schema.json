{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "labels_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "split": {
      "enum": [
        "validation",
        "test"
      ]
    },
    "parity": {
      "type": "object",
      "properties": {
        "score_absolute_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_box_iou": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "score_absolute_tolerance",
        "minimum_box_iou"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "enum": [
              "printed_daylight",
              "led",
              "night",
              "rain"
            ]
          },
          "ground_truth": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "box": {
                  "type": "object",
                  "properties": {
                    "left": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "top": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "right": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "bottom": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "left",
                    "top",
                    "right",
                    "bottom"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "class_id",
                "confidence",
                "box"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "expected_events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "session_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reset_generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "offset_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                },
                "labels_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "config": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "confidence_threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minimum_hits": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "confirmation_window_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "association_iou": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "rearm_absence_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "estimate_max_age_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "stop_display_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sampling_enabled": {
                      "type": "boolean"
                    },
                    "sample_interval_ms": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sample_budget_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "event_queue_capacity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "storage_budget_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "version",
                    "confidence_threshold",
                    "minimum_hits",
                    "confirmation_window_ms",
                    "association_iou",
                    "rearm_absence_ms",
                    "estimate_max_age_ms",
                    "stop_display_ms",
                    "sampling_enabled",
                    "sample_interval_ms",
                    "sample_budget_bytes",
                    "event_queue_capacity",
                    "storage_budget_bytes"
                  ],
                  "additionalProperties": false
                },
                "payload": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "confirmed_batch"
                        },
                        "frame_id": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "signs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "class_id": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "confidence": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "box": {
                                "type": "object",
                                "properties": {
                                  "left": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "top": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "right": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "bottom": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  }
                                },
                                "required": [
                                  "left",
                                  "top",
                                  "right",
                                  "bottom"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "class_id",
                              "confidence",
                              "box"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "kind",
                        "frame_id",
                        "signs"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "tick",
                            "reset"
                          ]
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "enum": [
                            "transition",
                            "conflict",
                            "error"
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_sequences": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 0
                        },
                        "details": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "reason",
                        "source_sequences",
                        "details"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "gap"
                        },
                        "dropped_events": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "kind",
                        "dropped_events"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "schema_version",
                "session_id",
                "reset_generation",
                "sequence",
                "offset_ms",
                "model_version",
                "labels_sha256",
                "config",
                "payload"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "scene_id",
          "sequence_id",
          "condition",
          "ground_truth",
          "expected_events"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "labels_sha256",
    "synthetic",
    "split",
    "parity",
    "scenes"
  ],
  "additionalProperties": false
}
