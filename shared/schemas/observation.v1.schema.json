{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "reset_generation": {
      "type": "integer",
      "minimum": 0
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "capture_offset_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "labels_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_id": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box": {
            "type": "object",
            "properties": {
              "left": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "top": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "right": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bottom": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "left",
              "top",
              "right",
              "bottom"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "class_id",
          "confidence",
          "box"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "reset_generation",
    "frame_id",
    "capture_offset_ms",
    "model_version",
    "labels_sha256",
    "detections"
  ],
  "additionalProperties": false
}
